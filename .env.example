# ============================================================================
# SeeRead — Docker environment configuration template
#
# Copy this file to `.env` (a working copy is already provided) and adjust for
# your machine. These variables serve two purposes:
#   1) ${VAR} interpolation in docker-compose.yml (build args, etc.)
#   2) variables listed below are also injected into the container via env_file
# Keep each comment on its own line (no inline comments after a value).
# ============================================================================

# --- Image build ------------------------------------------------------------
# CUDA + PyTorch base image. Choose a tag whose CUDA version is supported by
# the host NVIDIA driver (check `nvidia-smi`). torch>=2.1 / torchvision>=0.16
# from requirements.txt are already satisfied in this image and are not
# re-downloaded during the build.
# NOTE: Blackwell GPUs (sm_120, e.g. RTX 6000D / RTX PRO 6000) require a
# PyTorch >= 2.7 cu128 image; the 2.4.1-cuda12.4 default only covers older
# architectures (Ampere/Ada).
PYTORCH_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

# Optional PyPI mirror used while building the image (uncomment for CN networks)
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Non-root user UID/GID inside the container. On Linux set these to your host
# `id -u` / `id -g` so bind-mounted files under ./data and ./results stay
# writable. Docker Desktop (Windows/macOS) handles ownership automatically.
PUID=1000
PGID=1000

# --- Container runtime ------------------------------------------------------
# Restrict which GPUs the container sees
CUDA_VISIBLE_DEVICES=0

# Avoid tokenizer fork warnings with multiple DataLoader workers (data.workers)
TOKENIZERS_PARALLELISM=false

# Cap BLAS thread pools so torch does not spawn one OMP thread per host core
# in every DataLoader worker
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

# Container resource ceilings used by docker-compose.yml (mem_limit /
# memswap_limit / cpus of the training container). Keep memswap equal to
# MEM_LIMIT (no extra swap) so an OOM kills the container, not the host.
# Compose falls back to 128g / 64 when unset.
#MEM_LIMIT=128g
#CPUS=64

# Hugging Face cache for TrOCR weights (rec.type=trocr); must match the
# hf-cache volume mount in docker-compose.yml
HF_HOME=/home/appuser/.cache/huggingface

# Optional Hugging Face mirror / offline mode (uncomment as needed)
#HF_ENDPOINT=https://hf-mirror.com
#HF_HUB_OFFLINE=0
