# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- Local environment (template .env.example is tracked) ---
.env
.env.*
!.env.example

# --- Datasets & experiment outputs: keep the directory skeleton, ignore contents ---
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/annotations/*
!data/annotations/.gitkeep
!data/annotations/README.md
data/images/*
!data/images/.gitkeep
!data/images/README.md
data/images_lit/*
!data/images_lit/.gitkeep
!data/images_lit/README.md
results/*
!results/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
*.log

# --- Local tooling / generated caches (never tracked) ---
.cache_ctl/
.trae/
.workbuddy-ai/
data/lated_trans/
data/dark_totaltext_test/
data/dark_ctw1500_test/
