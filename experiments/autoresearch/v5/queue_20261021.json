{
  "container": "seeread-v5-run-20261020b",
  "gpu": 2,
  "cuda_allocator_config": "expandable_segments:True",
  "scope": "fresh public-start baselines; independent reduced-data detection; no old R4 migration; ESTR60 and official tests untouched",
  "jobs": [
    {
      "id": "D1_reduced_lated_short",
      "argv": [
        "python",
        "tools/v5_train_detection.py",
        "--config",
        "configs/v5/seeing_lated_dev_short.yaml",
        "--allow-reduced-data",
        "--public-only"
      ],
      "report": "results/v5/detection/D1_reduced_lated_short/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop",
        "budget_stop_validation_pending",
        "budget_stop_partial_development",
        "stage_complete"
      ],
      "log": "results/v5/queue_logs/20261021_D1_reduced_lated_short.log",
      "timeout_seconds": 1500
    },
    {
      "id": "R4b_amp_safe_short",
      "argv": [
        "python",
        "tools/v5_reading.py",
        "--config",
        "configs/v5/reading_paper_joint_amp_safe.yaml",
        "--mode",
        "train",
        "--device",
        "cuda:0"
      ],
      "report": "results/v5/reading/R4b_amp_safe/run.json",
      "log": "results/v5/queue_logs/20261021_R4b_amp_safe_short.log",
      "timeout_seconds": 1500
    },
    {
      "id": "Seeing_SynthText_short_v2",
      "argv": [
        "python",
        "tools/v5_train_detection.py",
        "--config",
        "configs/v5/seeing_synthtext.yaml",
        "--allow-reduced-data"
      ],
      "report": "results/v5/detection/SynthText_pretrain/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop",
        "stage_complete",
        "budget_stop_validation_pending",
        "budget_stop_partial_development"
      ],
      "log": "results/v5/queue_logs/20261021_SynthText_short.log",
      "timeout_seconds": 1500
    },
    {
      "id": "R4b_amp_safe_long",
      "argv": [
        "python",
        "tools/v5_reading.py",
        "--config",
        "configs/v5/reading_paper_joint_amp_safe.yaml",
        "--mode",
        "train",
        "--device",
        "cuda:0",
        "--resume",
        "results/v5/reading/R4b_amp_safe/last.pt",
        "--max-seconds",
        "7200",
        "--max-steps",
        "50740"
      ],
      "report": "results/v5/reading/R4b_amp_safe/run.json",
      "log": "results/v5/queue_logs/20261021_R4b_amp_safe_long.log",
      "timeout_seconds": 7800,
      "development_gate": {
        "candidate_report": "results/v5/reading/R4b_amp_safe/run.json",
        "reference_report": "results/v5/reading/R1_srdace_frozen/run.json",
        "minimum_cer_improvement": 0.01
      }
    },
    {
      "id": "Seeing_SynthText_long_v2",
      "argv": [
        "python",
        "tools/v5_train_detection.py",
        "--config",
        "configs/v5/seeing_synthtext_long.yaml",
        "--allow-reduced-data",
        "--resume",
        "results/v5/detection/SynthText_pretrain/last.pt"
      ],
      "report": "results/v5/detection/SynthText_pretrain/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop",
        "stage_complete",
        "budget_stop_validation_pending",
        "budget_stop_partial_development"
      ],
      "log": "results/v5/queue_logs/20261021_SynthText_long.log",
      "timeout_seconds": 7800
    }
  ]
}
