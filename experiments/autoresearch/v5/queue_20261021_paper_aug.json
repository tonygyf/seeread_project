{
  "container": "seeread-v5-run-20261020b",
  "gpu": 2,
  "cuda_allocator_config": "expandable_segments:True",
  "scope": "Public ImageNet start; SynthText fixed 2-epoch stage, 20min resource/numerical check then 2h continuation; no dev-performance claim before full dev; no MLT bypass or custom modules; no official tests; ESTR60 sealed",
  "jobs": [
    {
      "id": "Seeing_SynthText_paper_aug_short",
      "argv": [
        "python",
        "tools/v5_train_detection.py",
        "--config",
        "configs/v5/seeing_synthtext_paper_aug.yaml",
        "--allow-reduced-data"
      ],
      "report": "results/v5/detection/SynthText_paper_aug_20261021/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop",
        "budget_stop_validation_pending",
        "budget_stop_partial_development",
        "stage_complete"
      ],
      "log": "results/v5/queue_logs/20261021_SynthText_paper_aug_short.log",
      "timeout_seconds": 1500
    },
    {
      "id": "Seeing_SynthText_paper_aug_long",
      "argv": [
        "python",
        "tools/v5_train_detection.py",
        "--config",
        "results/v5/detection/SynthText_paper_aug_20261021_long.yaml",
        "--allow-reduced-data",
        "--resume",
        "results/v5/detection/SynthText_paper_aug_20261021/last.pt"
      ],
      "report": "results/v5/detection/SynthText_paper_aug_20261021/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop",
        "budget_stop_validation_pending",
        "budget_stop_partial_development",
        "stage_complete"
      ],
      "log": "results/v5/queue_logs/20261021_SynthText_paper_aug_long.log",
      "timeout_seconds": 7800
    }
  ]
}
