{
  "container": "seeread-v5-gpu3-20261022",
  "gpu": 3,
  "cuda_allocator_config": "expandable_segments:True",
  "scope": "Read-only wait for full shared SynthText2/MLT100, then independent CTW250 in parallel with GPU2 LATeD250. No concurrent writes to shared pretraining; unchanged batch10.",
  "jobs": [
    {
      "id": "CTW250_after_shared_MLT100",
      "argv": [
        "python",
        "tools/v5_train_detection_branch.py",
        "--pipeline",
        "configs/v5/seeing_pipeline_ctw1500_pm_fp32.yaml",
        "--upstream-state",
        "results/v5/queue_20261023_detection_pm_fp32.json"
      ],
      "report": "results/v5/detection/CTW1500_pm_fp32/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "stage_complete"
      ],
      "log": "results/v5/queue_logs/20261023_CTW_shared_pretraining_branch_gpu3.log",
      "timeout_seconds": 604800
    }
  ]
}
