{
  "container": "seeread-v5-gpu3-20261022",
  "gpu": 3,
  "cuda_allocator_config": "expandable_segments:True",
  "scope": "Completed baselines; fixed development pairs; compare original/adapted Read and retained/hull crops. No official test or training.",
  "jobs": [
    {
      "id": "ctw250_read10",
      "argv": [
        "python",
        "tools/v5_eval_connector.py",
        "--detector",
        "results/v5/detection/CTW1500_dsconv_fp32/best.pt",
        "--reading",
        "results/v5/fusion/read_connector_lora_20261025/best.pt",
        "--output",
        "results/v5/fusion/connector_ctw250_read10_hull_check_20261025",
        "--sampling",
        "boundary_when_supported",
        "boundary_with_hull_fallback",
        "--crop-pad",
        "1.1"
      ],
      "report": "results/v5/fusion/connector_ctw250_read10_hull_check_20261025/run.json",
      "log": "results/v5/queue_logs/20261025_ctw250_read10_hull_check.log",
      "timeout_seconds": 3600
    },
    {
      "id": "mlt100_read10",
      "argv": [
        "python",
        "tools/v5_eval_connector.py",
        "--detector",
        "results/v5/detection/MLT17_dsconv_fp32/last.pt",
        "--reading",
        "results/v5/fusion/read_connector_lora_20261025/best.pt",
        "--output",
        "results/v5/fusion/connector_mlt100_read10_hull_check_20261025",
        "--sampling",
        "boundary_when_supported",
        "boundary_with_hull_fallback",
        "--crop-pad",
        "1.1"
      ],
      "report": "results/v5/fusion/connector_mlt100_read10_hull_check_20261025/run.json",
      "log": "results/v5/queue_logs/20261025_mlt100_read10_hull_check.log",
      "timeout_seconds": 3600
    }
  ]
}
