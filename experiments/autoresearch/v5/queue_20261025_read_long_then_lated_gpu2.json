{
  "container": "seeread-v5-run-20261020b",
  "gpu": 2,
  "cuda_allocator_config": "expandable_segments:True",
  "scope": "Pilot passed preregistered dark-CER/E2E/bright gate. Resume Read LoRA to two complete paired-crop passes, evaluate frozen MLT connector, then complete healthy migrated LATeD250. Baselines/CTW untouched.",
  "jobs": [
    {
      "id": "Read_connector_LoRA_two_passes",
      "argv": [
        "python",
        "tools/v5_adapt_reading.py",
        "--output",
        "results/v5/fusion/read_connector_lora_20261025",
        "--resume",
        "results/v5/fusion/read_connector_lora_20261025/last.pt",
        "--max-steps",
        "8468",
        "--max-seconds",
        "0"
      ],
      "report": "results/v5/fusion/read_connector_lora_20261025/run.json",
      "log": "results/v5/queue_logs/20261025_read_connector_lora_two_passes.log",
      "timeout_seconds": 21600
    },
    {
      "id": "Read_long_fixed_MLT_connector",
      "argv": [
        "python",
        "tools/v5_eval_connector.py",
        "--detector",
        "results/v5/detection/MLT17_dsconv_fp32/last.pt",
        "--reading",
        "results/v5/fusion/read_connector_lora_20261025/best.pt",
        "--output",
        "results/v5/fusion/connector_mlt100_read_lora_long_20261025",
        "--sampling",
        "boundary_when_supported",
        "--crop-pad",
        "1.1"
      ],
      "report": "results/v5/fusion/connector_mlt100_read_lora_long_20261025/run.json",
      "log": "results/v5/queue_logs/20261025_read_connector_long_mlt_eval.log",
      "timeout_seconds": 1800
    },
    {
      "id": "LATeD_geometry_resume_to250",
      "argv": [
        "python",
        "tools/v5_recover_lated.py",
        "--config",
        "results/v5/runtime/lated_geometry_fp32_20261025/target.json",
        "--allow-reduced-data",
        "--resume",
        "results/v5/detection/LATeD_geometry_fp32_20261025/last.pt"
      ],
      "report": "results/v5/detection/LATeD_geometry_fp32_20261025/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "stage_complete"
      ],
      "log": "results/v5/queue_logs/20261025_LATeD_geometry_long.log",
      "timeout_seconds": 604800
    }
  ]
}
