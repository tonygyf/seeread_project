{
  "container": "seeread-v5-run-20261020b",
  "gpu": 2,
  "cuda_allocator_config": "expandable_segments:True",
  "wait_for_report": "results/v5/queue_20261026_scm_target_gpu2.json",
  "scope": "GPU3 yielded to external process; serial GPU2 recovery and Latin MVP preparation; no official test",
  "jobs": [
    {
      "id": "balanced_ce_resume5",
      "argv": [
        "python",
        "tools/v5_recover_lated.py",
        "--runtime",
        "results/v5/runtime/lated_balanced_ce_20261026",
        "--config",
        "experiments/autoresearch/v5/lated_balanced_ce_20261026.json",
        "--allow-reduced-data",
        "--resume",
        "results/v5/detection/LATeD_balanced_ce_20261026/last.pt"
      ],
      "report": "results/v5/detection/LATeD_balanced_ce_20261026/status.json",
      "report_status_path": [
        "state",
        "status"
      ],
      "acceptable_report_statuses": [
        "budget_stop"
      ],
      "log": "results/v5/queue_logs/20261026_balanced_ce_resume5.log",
      "timeout_seconds": 1800
    },
    {
      "id": "lated_drafts",
      "argv": [
        "python",
        "tools/v5_lated.py",
        "drafts"
      ],
      "report": "data/derived/v5/lated_mvp_20261026/drafts_provenance.json",
      "log": "results/v5/queue_logs/20261026_lated_drafts.log",
      "timeout_seconds": 3600
    },
    {
      "id": "lated_mvp_infer",
      "argv": [
        "python",
        "tools/v5_lated.py",
        "infer",
        "--output",
        "results/v5/fusion/lated_mvp_baseline_20261026"
      ],
      "report": "results/v5/fusion/lated_mvp_baseline_20261026/run.json",
      "log": "results/v5/queue_logs/20261026_lated_mvp_infer.log",
      "timeout_seconds": 3600
    }
  ]
}
