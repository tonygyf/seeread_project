+"""Fig.2: pre-PM F1 branches to SCM; image-only adaptive returns residually."""
+import torch
+from torch import nn
+from torch.nn import functional as F
+from seeread.v5.seeing import SeeingDetector
+
+class FakeDSConv(nn.Conv2d):
+    def __init__(self, cin, cout, **kwargs):
+        super().__init__(cin, cout, 3, padding=1)
+
+def test_fig2_branch_and_residual_are_the_actual_forward_path():
+    torch.set_num_threads(1)
+    torch.manual_seed(4)
+    model = SeeingDetector(channels=4, pretrained=False, dsconv_factory=FakeDSConv).train()
+    observed = {}
+    handles = [model.lateral[-1].register_forward_hook(lambda m,a,b: observed.update(deepest=b)),
+               model.pm[0].register_forward_pre_hook(lambda m,a: observed.update(pm_input=a[0])),
+               model.scm.register_forward_pre_hook(lambda m,a: observed.update(scm_input=a[0]))]
+    image = torch.rand(2,3,64,96)
+    result = model(image, with_scm=True, mask=torch.zeros(2,64,96,dtype=torch.long))
+    f1 = F.interpolate(observed['deepest'],size=(4,6),mode='bilinear',align_corners=False)
+    torch.testing.assert_close(observed['scm_input'],f1)
+    torch.testing.assert_close(observed['pm_input'][:,4:],f1+result['sem_main'])
+    other = model(image, with_scm=True, mask=torch.ones(2,64,96,dtype=torch.long))
+    for key in ('text','center','height','angle'):
+        torch.testing.assert_close(result[key],other[key],rtol=0,atol=0)
+    result['text'].square().mean().backward()
+    assert any(p.grad is not None and p.grad.abs().sum()>0 for p in model.semantic_adapter.parameters())
+    assert all(p.grad is None for p in model.scm.parameters())
+    for handle in handles:handle.remove()
