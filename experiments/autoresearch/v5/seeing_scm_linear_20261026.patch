+import torch
+from seeread.v5.seeing import SpatialConstraint
+
+def test_scm_semantic_target_keeps_signed_decoder_output():
+    module = SpatialConstraint(4).eval()
+    with torch.no_grad():
+        module.encoder[0].weight.zero_()
+        module.decoder[0][0].weight.fill_(.1)
+        module.decoder[1][0].weight.fill_(-.1)
+        output = module(torch.ones(1, 4, 8, 8), torch.zeros(1, 32, 32, dtype=torch.long))
+    assert (output['scm_sem'] < 0).all(), 'Fig2 final decoder Conv must retain negative semantic values'
+    assert ((output['scm_mask'] >= 0) & (output['scm_mask'] <= 1)).all()
